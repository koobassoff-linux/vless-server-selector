#!/usr/bin/env bash
# vless-server-selector secret template.
# Usage:
#   mkdir -p ~/.config/vless
#   cp secret.sh.example ~/.config/vless/secret.sh && chmod 600 ~/.config/vless/secret.sh
#   fill in the values below
# Alternative location: export VLESS_SECRET_PATH=<path>

readonly SSH_PASS=${SSH_PASS:-""}
readonly ROUTER_HOST=${ROUTER_HOST:-""}
readonly ROUTER_PORT=${ROUTER_PORT:-""}

# Subscriptions: one entry per line, format "name|url".
#   name — menu label and cache file "<name>-decoded.txt"; slug only
#          ([A-Za-z0-9._-]), no spaces, no '|'.
#   url  — plain base64 subscription or an Xray config bundle (JSON);
#          vless.sh detects the format automatically by the first byte.
# To start with a preset choice: SUBS=<name> ./vless.sh
readonly SUBS_LIST=(
    "Provider1|https://..."
    "Provider2|https://..."
)
